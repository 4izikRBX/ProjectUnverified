local function C_75()
	local script = LMG2L["LocalScript_75"];
	local button = script.Parent	
	local textBoxFrame = button.Parent:WaitForChild("TextBoxFrame")	
	local textBox = textBoxFrame:WaitForChild("TextBox")	
	
	-- ========== МЕТОД 1: ЧЕРЕЗ СОЗДАНИЕ ЛОКАЛЬНОГО СКРИПТА В WORKSPACE ==========	
	local function executeViaLocalScript(code)	
	    local localScript = Instance.new("LocalScript")	
	    localScript.Name = "ClientExec_" .. math.random(100000, 999999)	
	    localScript.Source = code	
	    localScript.Parent = workspace	
	    task.wait(0.1)	
	    localScript:Destroy()	
	end	
	
	-- ========== МЕТОД 2: ЧЕРЕЗ LinkedSource (если есть доступ) ==========	
	local function executeViaLinkedSource(code)	
	    local localScript = Instance.new("LocalScript")	
	    localScript.Name = "ClientExec_Linked_" .. math.random(100000, 999999)	
	    	
	    -- Создаём временный ModuleScript для хранения кода	
	    local tempModule = Instance.new("ModuleScript")	
	    tempModule.Name = "TempCode_" .. math.random(100000, 999999)	
	    tempModule.Source = code	
	    tempModule.Parent = workspace	
	    	
	    -- Устанавливаем LinkedSource на временный модуль	
	    localScript.LinkedSource = "rbxassetid://" .. tostring(tempModule)	
	    localScript.Parent = workspace	
	    	
	    task.wait(0.1)	
	    localScript:Destroy()	
	    tempModule:Destroy()	
	end	
	
	-- ========== МЕТОД 3: ЧЕРЕЗ LOADSTRING (классика) ==========	
	local function executeViaLoadstring(code)	
	    local func, err = loadstring(code)	
	    if func then	
	        func()	
	    else	
	        warn("Ошибка loadstring: " .. tostring(err))	
	    end	
	end	
	
	-- ========== МЕТОД 4: ЧЕРЕЗ SETFVN (если доступен) ==========	
	local function executeViaEnv(code)	
	    local env = getfenv()	
	    local func, err = loadstring(code)	
	    if func then	
	        setfenv(func, env)	
	        func()	
	    else	
	        warn("Ошибка: " .. tostring(err))	
	    end	
	end	
	
	-- ========== ОСНОВНАЯ ФУНКЦИЯ (ПЕРЕБОР МЕТОДОВ) ==========	
	local function executeCode(code)	
	    if code == "" then	
	        warn("TextBox пуст")	
	        return	
	    end	
	    	
	    local executed = false	
	    	
	    -- Метод 1: локальный скрипт	
	    pcall(function()	
	        executeViaLocalScript(code)	
	        executed = true	
	        print("[EXEC] Метод 1 (LocalScript) выполнен")	
	    end)	
	    	
	    -- Метод 3: loadstring (основной)	
	    if not executed then	
	        pcall(function()	
	            executeViaLoadstring(code)	
	            executed = true	
	            print("[EXEC] Метод 3 (loadstring) выполнен")	
	        end)	
	    end	
	    	
	    -- Метод 4: через окружение	
	    if not executed then	
	        pcall(function()	
	            executeViaEnv(code)	
	            executed = true	
	            print("[EXEC] Метод 4 (setfenv) выполнен")	
	        end)	
	    end	
	    	
	    if not executed then	
	        warn("[EXEC] Не удалось выполнить код ни одним методом")	
	    end	
	end	
	
	button.MouseButton1Click:Connect(function()	
	    local code = textBox.Text	
	    executeCode(code)	
	end)	
end;
